# ---------------------------------------------------------------
# Copiá este archivo como .env.local y completá los valores reales.
# .env.local NO se sube al repositorio (está en .gitignore).
# ---------------------------------------------------------------

# --- Supabase -----------------------------------------------------
# Panel de Supabase → Project Settings → API

# URL del proyecto (llega al navegador)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clave anónima / publishable (llega al navegador, respeta RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave service_role: SOLO SERVIDOR. Saltea RLS.
# Nunca ponerle el prefijo NEXT_PUBLIC_ ni usarla en componentes de cliente.
SUPABASE_SERVICE_ROLE_KEY=

# --- Impresora Zebra ZD421 ---------------------------------------
# IP fija de la impresora en la red de la fábrica.
# Se saca desde la impresora: menú de red o imprimiendo la config de red.
ZEBRA_IP=192.168.1.50

# Puerto raw de ZPL. 9100 es el estándar Zebra, no cambiarlo salvo que sepas por qué.
ZEBRA_PORT=9100
